<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Argenta.Core\Argenta.Core.csproj" />
    <ProjectReference Include="..\Argenta.Data\Argenta.Data.csproj" />
    <ProjectReference Include="..\Argenta.Modules.LibroCompras\Argenta.Modules.LibroCompras.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icono.ico</ApplicationIcon>
    <!-- Debe subir en cada release junto con el packVersion de "vpk pack": es lo que se muestra en el sidebar. -->
    <Version>1.0.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icono.ico" />
  </ItemGroup>

</Project>
