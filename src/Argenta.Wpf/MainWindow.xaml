<Window x:Class="Argenta.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Argenta — Suite Contable" Height="780" Width="1300" WindowStartupLocation="CenterScreen"
        Icon="Assets/icono.ico"
        Background="{DynamicResource ContenidoFondoBrush}" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Auto: al ocultar el sidebar (Visibility=Collapsed) la columna
                 se encoge sola a 0, sin necesitar convertir bool a GridLength. -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar (columna izquierda, todo el alto): se muestra/oculta con
             el botón ☰ del topbar, para ganar espacio en Operaciones/Catálogos. -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Width="240" Background="{DynamicResource SidebarFondoBrush}"
                Visibility="{Binding MenuExpandido, Converter={StaticResource BoolAVisibilidad}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,20">
                    <TextBlock Text="Argenta" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,0,20,0"/>
                    <TextBlock Text="SUITE CONTABLE" Foreground="{DynamicResource SidebarTextoBrush}" FontSize="10"
                               FontWeight="SemiBold" Margin="20,2,20,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,16">

                        <!-- Árbol Padres / Hijos -->
                        <ItemsControl ItemsSource="{Binding Menu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Button Content="{Binding Nombre}" Command="{Binding ComandoClic}"
                                                Style="{StaticResource BotonSidebarPadreStyle}"/>
                                        <ItemsControl ItemsSource="{Binding Hijos}"
                                                      Visibility="{Binding EstaExpandido, Converter={StaticResource BoolAVisibilidad}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Nombre}" Command="{Binding ComandoClic}"
                                                            Style="{StaticResource BotonSidebarHijoStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource SidebarSeparadorBrush}" Margin="20,16,20,16"/>

                        <!-- Ayuda (acciones directas, sin hijos) -->
                        <TextBlock Text="AYUDA" Foreground="{DynamicResource SidebarTextoBrush}" FontSize="11"
                                   FontWeight="Bold" Margin="20,0,20,4"/>
                        <ItemsControl ItemsSource="{Binding ElementosAyuda}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Nombre}" Command="{Binding Comando}"
                                            Style="{StaticResource BotonSidebarPadreStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Topbar -->
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource TopbarDegradadoBrush}">
            <Grid Margin="24,0">
                <Button Content="☰" Style="{StaticResource BotonIconoTopbarStyle}" Command="{Binding AlternarMenuCommand}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-8,0,0,0"
                         ToolTip="Mostrar/ocultar el menú"/>

                <!-- ☀/🌙: alterna modo claro/oscuro al instante. El icono refleja el
                     tema ACTIVO (☀ = claro, presiona para pasar a oscuro; 🌙 = oscuro,
                     presiona para volver a claro). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding IconoTema}" Command="{Binding AlternarTemaCommand}"
                            Style="{StaticResource BotonIconoTopbarStyle}" ToolTip="{Binding ToolTipTema}"
                            Margin="0,0,4,0"/>
                    <TextBlock Text="Argenta" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding VistaActual}"/>

        <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="0,1,0,0" Padding="24,8">
            <TextBlock Text="{Binding MensajeGlobal}" Foreground="{DynamicResource TextoSecundarioBrush}"/>
        </Border>
    </Grid>
</Window>
