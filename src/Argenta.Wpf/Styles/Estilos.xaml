<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- El diccionario de colores del tema (TemaClaro.xaml / TemaOscuro.xaml)
         NO se mezcla aquí: App.xaml.cs lo mantiene como una entrada aparte en
         Application.Resources.MergedDictionaries (ver ITemaService), para
         poder reemplazarlo en tiempo de ejecución. Los Setter de más abajo lo
         referencian por DynamicResource, así que lo encuentran igual subiendo
         por el árbol de recursos de la app. -->

    <!-- ===================== Tipografía / textos ===================== -->

    <Style x:Key="TituloSeccionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}"/>
    </Style>

    <Style x:Key="SubtituloStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}"/>
    </Style>

    <Style x:Key="EtiquetaCampoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- "Etiqueta" de solo lectura pero con texto seleccionable/copiable
         (TextBlock normal no permite seleccionar texto con el mouse). Se ve
         igual que un TextBlock: sin borde, sin fondo, mismo padding en 0.
         Usada en el detalle visual de factura (DetalleFacturaFelDialogo). -->
    <Style x:Key="TextoSeleccionableStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Botones ===================== -->

    <Style x:Key="BotonBaseStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource AcentoBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrimarioStyle" TargetType="Button" BasedOn="{StaticResource BotonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource AcentoBrush}"/>
    </Style>

    <Style x:Key="BotonPeligroStyle" TargetType="Button" BasedOn="{StaticResource BotonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PeligroBrush}"/>
    </Style>

    <Style x:Key="BotonSecundarioStyle" TargetType="Button" BasedOn="{StaticResource BotonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource BordeSuaveBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}"/>
    </Style>

    <!-- Botón redondo "+" para agregar registro -->
    <Style x:Key="BotonAgregarStyle" TargetType="Button" BasedOn="{StaticResource BotonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource AcentoBrush}"/>
        <Setter Property="Padding" Value="18,9"/>
    </Style>

    <!-- Botón pequeño de texto para acciones dentro de filas de tabla (Editar / Eliminar) -->
    <Style x:Key="BotonAccionTablaStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AcentoBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource FilaHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonAccionEliminarStyle" TargetType="Button" BasedOn="{StaticResource BotonAccionTablaStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PeligroBrush}"/>
    </Style>

    <!-- Botón de icono (☰) del topbar: sin fondo/borde, resalta con un blanco
         translúcido al pasar el mouse. Usado para mostrar/ocultar el sidebar. -->
    <Style x:Key="BotonIconoTopbarStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Campos de formulario ===================== -->

    <Style x:Key="CampoFormularioStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeSuaveBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextoPrimarioBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CampoComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeSuaveBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}"/>
    </Style>

    <Style x:Key="CampoBusquedaStyle" TargetType="TextBox" BasedOn="{StaticResource CampoFormularioStyle}">
        <Setter Property="Width" Value="260"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- ===================== Tarjetas ===================== -->

    <Style x:Key="TarjetaStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="12" ShadowDepth="2" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta compacta para el panel de resumen/totales en vivo (Libro de Compras XML) -->
    <Style x:Key="TarjetaResumenStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeSuaveBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- "Píldora" pequeña para los conteos por color del panel de resumen -->
    <Style x:Key="PildoraConteoStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ===================== DataGrid ===================== -->

    <Style x:Key="EncabezadoTablaStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource EncabezadoTablaFondoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FilaSeparadorBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="FilaTablaStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FilaHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CeldaTablaStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimarioBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Resalta la celda seleccionada (selección por celda, ver EstiloDataGridStyle),
             para que se vea claramente cuál se va a copiar. -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource FilaHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource FilaSeparadorBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeSuaveBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EncabezadoTablaStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource FilaTablaStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource CeldaTablaStyle}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <!-- Selección por celda (no por fila completa): cada celda se puede
             seleccionar por separado, y con Shift/Ctrl se puede extender a
             varias, para copiar el contenido con Ctrl+C. -->
        <Setter Property="SelectionUnit" Value="Cell"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

</ResourceDictionary>
