<Window x:Class="Argenta.Wpf.Views.Dialogos.DetalleFacturaFelDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de factura" Width="860" Height="700" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ContenidoFondoBrush}"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource TarjetaStyle}" Padding="28">
                <StackPanel>
                    <!-- Encabezado: emisor a la izquierda, datos del documento a la derecha.
                         Los campos con datos de la factura son TextBox de solo lectura (no
                         TextBlock) para que el usuario pueda seleccionar y copiar el texto. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FACTURA" Style="{StaticResource TituloSeccionStyle}" FontSize="22"/>
                            <TextBox x:Name="TxtNombreEmisor" Style="{StaticResource TextoSeleccionableStyle}"
                                     FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                            <TextBox x:Name="TxtNombreComercial" Style="{StaticResource TextoSeleccionableStyle}"
                                     Foreground="{DynamicResource TextoSecundarioBrush}"/>
                            <TextBox x:Name="TxtNitEmisor" Style="{StaticResource TextoSeleccionableStyle}" Margin="0,6,0,0"/>
                            <TextBox x:Name="TxtDireccionEmisor" Style="{StaticResource TextoSeleccionableStyle}" TextWrapping="Wrap" MaxWidth="380"
                                     Foreground="{DynamicResource TextoSecundarioBrush}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource AcentoBrush}" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right">
                                <TextBox x:Name="TxtTipoDte" Style="{StaticResource TextoSeleccionableStyle}"
                                         FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBox x:Name="TxtSerieNumero" Style="{StaticResource TextoSeleccionableStyle}"
                                     HorizontalAlignment="Right" Margin="0,10,0,0" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtNumeroAutorizacion" Style="{StaticResource TextoSeleccionableStyle}"
                                     HorizontalAlignment="Right" FontSize="11"
                                     Foreground="{DynamicResource TextoSecundarioBrush}" TextWrapping="Wrap" MaxWidth="260" Margin="0,2,0,0"/>
                            <TextBox x:Name="TxtFechaEmision" Style="{StaticResource TextoSeleccionableStyle}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            <TextBox x:Name="TxtFechaCertificacion" Style="{StaticResource TextoSeleccionableStyle}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            <TextBox x:Name="TxtMoneda" Style="{StaticResource TextoSeleccionableStyle}" HorizontalAlignment="Right" Margin="0,6,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                    <!-- Receptor -->
                    <TextBlock Text="Receptor" Style="{StaticResource EtiquetaCampoStyle}"/>
                    <TextBox x:Name="TxtReceptor" Style="{StaticResource TextoSeleccionableStyle}" Margin="0,0,0,20" FontSize="13"/>

                    <!-- Detalle de items -->
                    <TextBlock Text="Detalle" Style="{StaticResource EtiquetaCampoStyle}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="GridItems" Style="{StaticResource EstiloDataGridStyle}" Margin="0,0,0,20"
                              AutoGenerateColumns="False" MaxHeight="420" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No." Binding="{Binding NumeroLinea}" Width="0.5*"/>
                            <DataGridTextColumn Header="B/S" Binding="{Binding BienOServicio}" Width="0.7*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat=N2}" Width="0.8*"/>

                            <!-- Descripción completa, sin recortar: se envuelve en varias líneas
                                 y la fila crece para mostrarla entera (Width=Auto = ancho por contenido,
                                 no fracción, para no comprimirla junto a las demás columnas). -->
                            <DataGridTemplateColumn Header="Descripción" Width="3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PrecioUnitario, StringFormat=N2}" Width="1*"/>

                            <DataGridTemplateColumn Header="Impuestos" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ImpuestosTexto}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totales -->
                    <StackPanel HorizontalAlignment="Right" MinWidth="280">
                        <ItemsControl x:Name="ListaTotalesImpuestos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource TextoSeleccionableStyle}"
                                                 Text="{Binding Nombre, Mode=OneWay}" Foreground="{DynamicResource TextoSecundarioBrush}"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource TextoSeleccionableStyle}"
                                                 Text="{Binding Monto, StringFormat=N2, Mode=OneWay}" Margin="24,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="0,1,0,0" Margin="0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gran Total" FontWeight="Bold" FontSize="16"/>
                            <TextBox Grid.Column="1" x:Name="TxtGranTotal" Style="{StaticResource TextoSeleccionableStyle}"
                                     FontWeight="Bold" FontSize="16" Margin="24,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Cerrar" Style="{StaticResource BotonPrimarioStyle}"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cerrar_Click"/>
    </Grid>
</Window>
