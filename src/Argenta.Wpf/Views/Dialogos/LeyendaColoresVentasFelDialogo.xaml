<Window x:Class="Argenta.Wpf.Views.Dialogos.LeyendaColoresVentasFelDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Significado de los colores" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TarjetaFondoBrush}"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Significado de los colores" Style="{StaticResource TituloSeccionStyle}"
                   FontSize="18" Margin="0,0,0,16"/>

        <!-- Amarillo -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource FilaDescuadreIvaBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Descuadre de IVA" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="El IVA calculado (Ventas + Servicios × 12%) difiere en más de Q0.10 del IVA de la factura. Revísela."/>
            </TextBlock>
        </StackPanel>

        <!-- Sin color -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource TarjetaFondoBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Sin color" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="Factura sin observaciones. En ventas no hay naranja ni rojo: nada se descarta ni se marca para revisión por catálogo — solo el filtro de IVA."/>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="3" Content="Cerrar" Style="{StaticResource BotonPrimarioStyle}"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cerrar_Click"/>
    </Grid>
</Window>
