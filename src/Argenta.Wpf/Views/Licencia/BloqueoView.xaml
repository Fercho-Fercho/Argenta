<UserControl x:Class="Argenta.Wpf.Views.Licencia.BloqueoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Foreground="{DynamicResource TextoPrimarioBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid>
        <Border Style="{StaticResource TarjetaStyle}" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
            <StackPanel>
                <TextBlock Text="🔒" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Esta computadora no está autorizada" Style="{StaticResource TituloSeccionStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Mensaje}" Style="{StaticResource SubtituloStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="Envíe este código al proveedor para activar su equipo." Style="{StaticResource SubtituloStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="CÓDIGO DE ESTA COMPUTADORA" Style="{StaticResource EtiquetaCampoStyle}" HorizontalAlignment="Center"/>
                <Border Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                    <TextBox Text="{Binding CodigoMaquina, Mode=OneWay}" Style="{StaticResource TextoSeleccionableStyle}"
                             FontFamily="Consolas" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                             HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="Copiar código" Command="{Binding CopiarCommand}" Style="{StaticResource BotonPrimarioStyle}" Margin="0,0,10,0"/>
                    <Button Content="Reintentar validación" Command="{Binding ValidarAhoraCommand}" Style="{StaticResource BotonSecundarioStyle}"/>
                </StackPanel>
                <TextBlock Text="✓ Código copiado al portapapeles" Foreground="{DynamicResource AcentoBrush}" FontSize="12"
                           HorizontalAlignment="Center" Visibility="{Binding Copiado, Converter={StaticResource BoolAVisibilidad}}" Margin="0,4,0,0"/>
                <TextBlock Text="Validando..." Foreground="{DynamicResource TextoSecundarioBrush}" FontSize="12"
                           HorizontalAlignment="Center" Visibility="{Binding Validando, Converter={StaticResource BoolAVisibilidad}}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
