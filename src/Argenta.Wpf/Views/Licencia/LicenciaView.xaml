<UserControl x:Class="Argenta.Wpf.Views.Licencia.LicenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{DynamicResource TextoPrimarioBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Licencia / Acerca de" Style="{StaticResource TituloSeccionStyle}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource TarjetaStyle}" MaxWidth="560" HorizontalAlignment="Left" Padding="24">
            <StackPanel>
                <TextBlock Text="ESTADO" Style="{StaticResource EtiquetaCampoStyle}"/>
                <TextBlock Text="{Binding EstadoTexto}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Text="ÚLTIMA VALIDACIÓN EXITOSA" Style="{StaticResource EtiquetaCampoStyle}"/>
                <TextBlock Text="{Binding UltimaValidacionTexto}" Margin="0,0,0,16"/>

                <TextBlock Text="CÓDIGO DE ESTA COMPUTADORA" Style="{StaticResource EtiquetaCampoStyle}"/>
                <Border Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                    <TextBox Text="{Binding CodigoMaquina, Mode=OneWay}" Style="{StaticResource TextoSeleccionableStyle}"
                             FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Copiar código" Command="{Binding CopiarCommand}" Style="{StaticResource BotonSecundarioStyle}" Margin="0,0,10,0"/>
                    <Button Content="Validar ahora" Command="{Binding ValidarAhoraCommand}" Style="{StaticResource BotonPrimarioStyle}"/>
                </StackPanel>
                <TextBlock Text="✓ Código copiado al portapapeles" Foreground="{DynamicResource AcentoBrush}" FontSize="12"
                           Visibility="{Binding Copiado, Converter={StaticResource BoolAVisibilidad}}" Margin="0,8,0,0"/>
                <TextBlock Text="Validando..." Foreground="{DynamicResource TextoSecundarioBrush}" FontSize="12"
                           Visibility="{Binding Validando, Converter={StaticResource BoolAVisibilidad}}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
