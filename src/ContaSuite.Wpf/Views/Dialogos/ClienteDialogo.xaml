<Window x:Class="ContaSuite.Wpf.Views.Dialogos.ClienteDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente" Width="700" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TarjetaFondoBrush}"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                   Style="{StaticResource TituloSeccionStyle}" FontSize="20" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Nombre" Style="{StaticResource EtiquetaCampoStyle}"/>
        <TextBox Grid.Row="2" x:Name="TxtNombre" Style="{StaticResource CampoFormularioStyle}" Margin="0,0,0,12"/>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="NIT" Style="{StaticResource EtiquetaCampoStyle}"/>
                <TextBox x:Name="TxtNit" Style="{StaticResource CampoFormularioStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,8">
                <CheckBox x:Name="ChkActivo" Content="Activo" IsChecked="True" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Tipo y Exporta viven por establecimiento (no aquí): un mismo
             cliente puede tener varios, cada uno de distinto tipo y con o
             sin exportación. -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Establecimientos" Style="{StaticResource EtiquetaCampoStyle}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+" Width="34" Height="34" Padding="0" FontSize="18" FontWeight="Bold"
                    Style="{StaticResource BotonPrimarioStyle}" Click="AgregarEstablecimiento_Click"
                    ToolTip="Agregar establecimiento"/>
        </Grid>

        <DataGrid Grid.Row="5" x:Name="GridEstablecimientos" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Style="{StaticResource EstiloDataGridStyle}" MinHeight="150" MaxHeight="260" Margin="0,0,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="0.7*"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="1*"/>
                <DataGridCheckBoxColumn Header="Exporta" Binding="{Binding Exporta}" Width="0.7*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Acción" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Style="{StaticResource BotonAccionTablaStyle}" Click="EditarEstablecimiento_Click"/>
                                <Button Content="Eliminar" Style="{StaticResource BotonAccionEliminarStyle}" Click="EliminarEstablecimiento_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Text="Debe tener al menos un establecimiento." FontSize="11"
                   Foreground="{DynamicResource TextoSecundarioBrush}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="7" x:Name="TxtError" Foreground="{DynamicResource PeligroBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,8" FontSize="12"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundarioStyle}" Click="Cancelar_Click" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrimarioStyle}" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
