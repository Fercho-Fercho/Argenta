<Window x:Class="ContaSuite.Wpf.Views.Dialogos.EstablecimientoDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Establecimiento" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TarjetaFondoBrush}"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                   Style="{StaticResource TituloSeccionStyle}" FontSize="20" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Número de establecimiento" Style="{StaticResource EtiquetaCampoStyle}"/>
        <TextBox Grid.Row="2" x:Name="TxtNumero" Style="{StaticResource CampoFormularioStyle}" Margin="0,0,0,12"
                 ToolTip="Código de establecimiento tal como lo trae el DTE. Único para este cliente, no tiene que ser correlativo."/>

        <TextBlock Grid.Row="3" Text="Nombre" Style="{StaticResource EtiquetaCampoStyle}"/>
        <TextBox Grid.Row="4" x:Name="TxtNombre" Style="{StaticResource CampoFormularioStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="5" Text="Tipo" Style="{StaticResource EtiquetaCampoStyle}"/>
        <ComboBox Grid.Row="6" x:Name="ComboTipo" Style="{StaticResource CampoComboBoxStyle}" Margin="0,0,0,12"
                  DisplayMemberPath="Texto"/>

        <CheckBox Grid.Row="7" x:Name="ChkExporta" Content="Exporta (agrega columna Exportaciones al libro de ventas de este establecimiento)"
                   Margin="0,4,0,4"/>

        <TextBlock Grid.Row="8" x:Name="TxtError" Foreground="{DynamicResource PeligroBrush}" TextWrapping="Wrap"
                   Margin="0,8,0,0" FontSize="12"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,36,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundarioStyle}" Click="Cancelar_Click" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrimarioStyle}" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
