<Window x:Class="ContaSuite.Wpf.Views.Dialogos.LeyendaColoresFelDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Significado de los colores" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TarjetaFondoBrush}"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Significado de los colores" Style="{StaticResource TituloSeccionStyle}"
                   FontSize="18" Margin="0,0,0,16"/>

        <!-- Naranja -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource FilaRevisionBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Proveedor marcado para revisión manual" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="El NIT del emisor está en el catálogo &quot;Proveedores a revisar&quot; con acción Revisar. La factura queda incluida igual, solo se resalta para que la revises; los montos no cambian."/>
            </TextBlock>
        </StackPanel>

        <!-- Rojo suave -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource FilaExcluidaCatalogoBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Excluida automáticamente" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="El NIT del emisor está en el catálogo &quot;Proveedores a revisar&quot; con acción Excluir siempre. La factura arranca desmarcada (no entra al libro ni suma), pero puedes reactivarla marcando su casilla &quot;Incluir&quot;."/>
            </TextBlock>
        </StackPanel>

        <!-- Amarillo -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource FilaDescuadreIvaBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Descuadre de IVA" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="El IVA calculado (Compras + Servicios × 12%) difiere en más de Q0.10 del IVA de la factura. Aplica a los documentos que se manejan con IVA (Grupo A y Grupo C). Revisa la factura."/>
            </TextBlock>
        </StackPanel>

        <!-- Mitad y mitad -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource FilaMitadNaranjaAmarilloBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Mitad naranja / mitad amarillo" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="La factura tiene ambos problemas a la vez: proveedor marcado para revisión y descuadre de IVA."/>
            </TextBlock>
        </StackPanel>

        <!-- Sin color -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Top">
            <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource TarjetaFondoBrush}"
                    BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1" VerticalAlignment="Top"/>
            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="340">
                <Run Text="Sin color" FontWeight="Bold"/>
                <LineBreak/>
                <Run Text="Factura sin observaciones. Aquí no existe el marcado naranja de &quot;proveedor no encontrado&quot; del catálogo de Proveedores normal: cada factura ya trae su propia clasificación Bien/Servicio por ítem."/>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="6" Content="Cerrar" Style="{StaticResource BotonPrimarioStyle}"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cerrar_Click"/>
    </Grid>
</Window>
