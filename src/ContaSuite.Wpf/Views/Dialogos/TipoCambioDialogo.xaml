<Window x:Class="ContaSuite.Wpf.Views.Dialogos.TipoCambioDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tipo de Cambio" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource TarjetaFondoBrush}"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextoPrimarioBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                   Style="{StaticResource TituloSeccionStyle}" FontSize="20" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Fecha" Style="{StaticResource EtiquetaCampoStyle}"/>
        <DatePicker Grid.Row="2" x:Name="FechaPicker" Margin="0,0,0,12" Padding="8"/>

        <TextBlock Grid.Row="3" Text="Valor (Quetzales por Dólar)" Style="{StaticResource EtiquetaCampoStyle}"/>
        <TextBox Grid.Row="4" x:Name="TxtValor" Style="{StaticResource CampoFormularioStyle}" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="5" x:Name="TxtError" Foreground="{DynamicResource PeligroBrush}" TextWrapping="Wrap"
                   Margin="0,8,0,0" FontSize="12"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,36,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundarioStyle}" Click="Cancelar_Click" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrimarioStyle}" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
