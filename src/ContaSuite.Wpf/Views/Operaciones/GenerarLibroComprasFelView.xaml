<UserControl x:Class="ContaSuite.Wpf.Views.Operaciones.GenerarLibroComprasFelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ContaSuite.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             Foreground="{DynamicResource TextoPrimarioBrush}">
    <UserControl.Resources>
        <conv:SeveridadAColorConverter x:Key="SeveridadAColorConverter"/>
        <conv:NuloOVacioAVisibilidadConverter x:Key="NuloOVacioAVisibilidadConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Libro de Compras (XML)" FontSize="20" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="Info" Command="{Binding MostrarInfoColoresCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTip="¿Qué significan los colores?"/>
        </Grid>

        <!-- Cliente detectado: solo lectura, nunca seleccionable (igual que la otra pestaña) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Cliente:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Border Background="{DynamicResource ContenidoFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" MinWidth="320" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClienteTextoMostrado}" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Border>
            <Button Content="+ Agregar cliente al catálogo" Command="{Binding AgregarClienteDetectadoCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" Margin="12,0,0,0"
                    Visibility="{Binding ClienteNoRegistrado, Converter={StaticResource BoolAVisibilidad}}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding ClienteAdvertencia}" Foreground="{DynamicResource AdvertenciaBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                   Visibility="{Binding ClienteAdvertencia, Converter={StaticResource NuloOVacioAVisibilidadConverter}}"/>

        <!-- Archivo -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="1. Seleccionar ZIP de facturas electrónicas (.zip)..." Command="{Binding SeleccionarArchivoCommand}"
                    Style="{StaticResource BotonPrimarioStyle}" Margin="0,0,8,0"/>
            <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Style="{StaticResource BotonSecundarioStyle}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding RutaArchivo, StringFormat='Archivo: {0}'}" Margin="0,0,0,4" FontStyle="Italic"/>

        <!-- Validar / advertencias / generar / contador -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="2. Validar de nuevo" Command="{Binding ValidarYClasificarCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" Margin="0,0,16,0"/>
            <CheckBox Content="He revisado las advertencias y deseo continuar" IsChecked="{Binding AdvertenciasReconocidas}"
                      Visibility="{Binding TieneAdvertencias, Converter={StaticResource BoolAVisibilidad}}"
                      VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="3. Generar libro de compras (.xlsx)" Command="{Binding GenerarCommand}"
                    Style="{StaticResource BotonPrimarioStyle}" Margin="0,0,8,0"
                    ToolTip="Genera el Excel y guarda automáticamente qué facturas quedaron incluidas/excluidas para este cliente y mes"/>
            <Button Content="Generar PDF" Command="{Binding GenerarPdfCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" Margin="0,0,16,0"
                    ToolTip="Genera una versión PDF, lista para imprimir, de la misma tabla de facturas (con folio y encabezados repetidos en cada hoja)"/>
        </StackPanel>

        <!-- Contenido: hallazgos + vista previa + aparte CIVA/NABN. Se envuelve en
             un ScrollViewer para que la pantalla completa desplace verticalmente
             en vez de achicar la tabla de facturas (que crece a su tamaño natural). -->
        <ScrollViewer x:Name="ScrollPrincipal" Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MaxHeight="180"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Hallazgos}" Margin="0,0,0,8" Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                      Visibility="{Binding Hallazgos.Count, Converter={x:Static conv:ContadorAVisibilidadConverter.Instancia}}"
                      PreviewMouseWheel="ReenviarRuedaAlScrollPrincipal">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                                   Foreground="{Binding Severidad, Converter={StaticResource SeveridadAColorConverter}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Conteos: incluidas / para revisar / excluidas por catálogo / descuadre de IVA -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="Incluidas: " Foreground="{DynamicResource TextoSecundarioBrush}"/>
                    <Run Text="{Binding FacturasIncluidas, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" / " Foreground="{DynamicResource TextoSecundarioBrush}"/>
                    <Run Text="{Binding TotalFacturas, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <Border Style="{StaticResource PildoraConteoStyle}" Background="{DynamicResource FilaRevisionBrush}">
                    <TextBlock Text="{Binding ResumenNaranja, StringFormat='{}{0} para revisar'}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border Style="{StaticResource PildoraConteoStyle}" Background="{DynamicResource FilaExcluidaCatalogoBrush}">
                    <TextBlock Text="{Binding ResumenRojo, StringFormat='{}{0} excluidas por catálogo'}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border Style="{StaticResource PildoraConteoStyle}" Background="{DynamicResource FilaDescuadreIvaBrush}" Margin="0">
                    <TextBlock Text="{Binding ResumenAmarillo, StringFormat='{}{0} con descuadre de IVA'}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Esta fuente no usa el catálogo de Proveedores normal (no hay
                 "no encontrado"), pero sí el catálogo separado "Proveedores a
                 revisar": naranja = Revisar, rojo suave = Excluir siempre,
                 amarillo = descuadre de IVA, mitad naranja/amarillo = las dos
                 primeras a la vez. -->
            <!-- MaxHeight (no Height fijo): dentro de ese límite la tabla ocupa su
                 tamaño natural igual que antes; si las filas lo superan, el DataGrid
                 usa su propio scroll interno con encabezados fijos (comportamiento
                 nativo), y ReenviarRuedaAlScrollPrincipal delega a la página solo
                 cuando ya no queda nada que desplazar adentro. -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserSortColumns="True" MaxHeight="560"
                      SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                      ColumnHeaderStyle="{StaticResource EncabezadoTablaStyle}" CellStyle="{StaticResource CeldaTablaStyle}"
                      Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                      BorderThickness="1" PreviewMouseWheel="ReenviarRuedaAlScrollPrincipal">
                <DataGrid.RowStyle>
                    <!-- El fondo base se pone como Setter (no como DataGrid.RowBackground/
                         AlternatingRowBackground): esas dos propiedades el DataGrid las aplica
                         con SetValue directo sobre cada fila, que tiene MÁS prioridad que un
                         DataTrigger de este mismo Style y por eso pisaba silenciosamente los
                         colores de clasificación (naranja/rojo/amarillo). -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
                        <Style.Triggers>
                            <!-- MarcadoParaRevisar y ExcluidoPorCatalogo nunca son true a la vez
                                 (vienen de la misma Accion de un solo proveedor). DescuadreIva sí
                                 puede coincidir con cualquiera de las dos; se declara primero para
                                 que, en ese caso, gane el naranja o el rojo (más accionables). -->
                            <DataTrigger Binding="{Binding DescuadreIva}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FilaDescuadreIvaBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MarcadoParaRevisar}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FilaRevisionBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExcluidoPorCatalogo}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FilaExcluidaCatalogoBrush}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding MarcadoParaRevisar}" Value="True"/>
                                    <Condition Binding="{Binding DescuadreIva}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource FilaMitadNaranjaAmarilloBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- CheckBox directo en la celda (no DataGridCheckBoxColumn): así responde
                         al primer clic en vez de necesitar dos. SortMemberPath habilita ordenar
                         por esta columna (marcadas/desmarcadas) al hacer clic en su encabezado,
                         igual que las demás columnas — un DataGridTemplateColumn no lo trae por
                         defecto, hay que indicarlo a mano. -->
                    <DataGridTemplateColumn Header="Incluir" Width="0.6*" SortMemberPath="Incluida">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Incluida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="No." Binding="{Binding Numero}" Width="0.5*" IsReadOnly="True" SortMemberPath="Numero"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="0.8*" IsReadOnly="True" SortMemberPath="Fecha"/>
                    <DataGridTextColumn Header="Docto" Binding="{Binding Docto}" Width="0.6*" IsReadOnly="True" SortMemberPath="Docto"/>
                    <DataGridTextColumn Header="Nit" Binding="{Binding Nit}" Width="0.8*" IsReadOnly="True" SortMemberPath="Nit"/>
                    <DataGridTextColumn Header="Nombre Emisor" Binding="{Binding Proveedor}" Width="2*" IsReadOnly="True" SortMemberPath="Proveedor"/>
                    <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding OrigenFel.NombreComercial}" Width="1.6*" IsReadOnly="True" SortMemberPath="OrigenFel.NombreComercial"/>
                    <DataGridTextColumn Header="Compras" Binding="{Binding Compras, StringFormat=N2}" Width="0.9*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Servicios" Binding="{Binding Servicios, StringFormat=N2}" Width="0.9*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Exento" Binding="{Binding Exento, StringFormat=N2}" Width="0.9*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Iva" Binding="{Binding Iva, StringFormat=N2}" Width="0.9*" IsReadOnly="True"/>

                    <!-- Columna informativa: NO se exporta al Excel de salida -->
                    <DataGridTextColumn Header="Cálculo de IVA" Binding="{Binding CalculoIva, StringFormat=N2}" Width="1*" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource EncabezadoTablaStyle}">
                                <Setter Property="Background" Value="{DynamicResource ColumnaInformativaFondoBrush}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource CeldaTablaStyle}">
                                <Setter Property="Background" Value="{DynamicResource ColumnaInformativaFondoBrush}"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="0.9*" IsReadOnly="True"/>

                    <!-- Detalle visual de la factura (Cambio 6) -->
                    <DataGridTemplateColumn Header="Detalle" Width="0.7*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Ver" Style="{StaticResource BotonAccionTablaStyle}"
                                        Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Guardado rápido al catálogo "Proveedores a revisar": el NIT y el
                         Nombre ya se conocen (vienen de la factura), un clic guarda y
                         reclasifica al instante, sin salir de esta pantalla. -->
                    <DataGridTemplateColumn Header="Añadir al catálogo" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Revisar" Style="{StaticResource BotonAccionTablaStyle}"
                                            ToolTip="Guardar este proveedor en &quot;Proveedores a revisar&quot; con acción Revisar (se resalta en naranja)"
                                            Command="{Binding DataContext.MarcarParaRevisarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Excluir" Style="{StaticResource BotonAccionEliminarStyle}"
                                            ToolTip="Guardar este proveedor en &quot;Proveedores a revisar&quot; con acción Excluir siempre (arranca desmarcado, en rojo suave)"
                                            Command="{Binding DataContext.ExcluirSiempreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Resumen/totales en vivo, siempre sobre TODAS las facturas incluidas. -->
            <UniformGrid Grid.Row="3" Rows="1" Columns="5" Margin="0,12,0,0">
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="Compras" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenTotalCompras, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="Servicios" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenTotalServicios, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="Exento" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenTotalExento, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="IVA / Crédito fiscal" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenTotalIva, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Gran Total" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenGranTotal, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AcentoBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Facturas tipo CIVA / NABN: van aparte del libro (no afectan totales ni correlativo principal) -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0"
                        Visibility="{Binding FilasAparte.Count, Converter={x:Static conv:ContadorAVisibilidadConverter.Instancia}}">
                <TextBlock Text="Facturas aparte (CIVA / NABN) — no afectan el libro de compras" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding FilasAparte}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="True" MaxHeight="160"
                          SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                          ColumnHeaderStyle="{StaticResource EncabezadoTablaStyle}" CellStyle="{StaticResource CeldaTablaStyle}"
                          RowStyle="{StaticResource FilaTablaStyle}"
                          Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                          BorderThickness="1" PreviewMouseWheel="ReenviarRuedaAlScrollPrincipal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="0.8*" SortMemberPath="Fecha"/>
                        <DataGridTextColumn Header="Docto" Binding="{Binding Docto}" Width="0.6*" SortMemberPath="Docto"/>
                        <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="1*" SortMemberPath="Serie"/>
                        <DataGridTextColumn Header="No. Doc" Binding="{Binding NoDoc}" Width="1*" SortMemberPath="NoDoc"/>
                        <DataGridTextColumn Header="Nit" Binding="{Binding Nit}" Width="0.8*" SortMemberPath="Nit"/>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="2.2*" SortMemberPath="Proveedor"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="0.9*"/>
                        <DataGridTemplateColumn Header="Detalle" Width="0.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ver" Style="{StaticResource BotonAccionTablaStyle}"
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="7" Text="{Binding MensajeEstado}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </Grid>
</UserControl>
