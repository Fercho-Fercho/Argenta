<UserControl x:Class="ContaSuite.Wpf.Views.Operaciones.GenerarLibroVentasFelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ContaSuite.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             Foreground="{DynamicResource TextoPrimarioBrush}">
    <UserControl.Resources>
        <conv:SeveridadAColorConverter x:Key="SeveridadAColorConverter"/>
        <conv:NuloOVacioAVisibilidadConverter x:Key="NuloOVacioAVisibilidadConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Libro de Ventas (XML)" FontSize="20" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="Info" Command="{Binding MostrarInfoColoresCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTip="¿Qué significan los colores?"/>
        </Grid>

        <!-- Cliente detectado: el EMISOR de las facturas (es quien vende), solo lectura -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Cliente:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Border Background="{DynamicResource ContenidoFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" MinWidth="320" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClienteTextoMostrado}" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Border>
            <Button Content="+ Agregar cliente al catálogo" Command="{Binding AgregarClienteDetectadoCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" Margin="12,0,0,0"
                    Visibility="{Binding ClienteNoRegistrado, Converter={StaticResource BoolAVisibilidad}}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding ClienteAdvertencia}" Foreground="{DynamicResource AdvertenciaBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                   Visibility="{Binding ClienteAdvertencia, Converter={StaticResource NuloOVacioAVisibilidadConverter}}"/>

        <!-- Archivos: a diferencia de compras, aquí hacen falta DOS -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="1. Seleccionar ZIP de facturas electrónicas (.zip)..." Command="{Binding SeleccionarArchivoZipCommand}"
                    Style="{StaticResource BotonPrimarioStyle}" Margin="0,0,8,0"/>
            <Button Content="2. Seleccionar Excel de consulta de documentos (.xls)..." Command="{Binding SeleccionarArchivoEstadosCommand}"
                    Style="{StaticResource BotonPrimarioStyle}" Margin="0,0,8,0"
                    ToolTip="El .xls &quot;Consulta de documentos&quot; del SAT: es la única forma de saber cuáles facturas están anuladas."/>
            <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Style="{StaticResource BotonSecundarioStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,4">
            <TextBlock Text="{Binding RutaArchivoZip, StringFormat='ZIP: {0}'}" FontStyle="Italic"
                       Visibility="{Binding RutaArchivoZip, Converter={StaticResource NuloOVacioAVisibilidadConverter}}"/>
            <TextBlock Text="{Binding RutaArchivoEstados, StringFormat='Excel de consulta: {0}'}" FontStyle="Italic"
                       Visibility="{Binding RutaArchivoEstados, Converter={StaticResource NuloOVacioAVisibilidadConverter}}"/>
        </StackPanel>

        <!-- Validar / advertencias / generar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="3. Validar de nuevo" Command="{Binding ValidarYClasificarCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" Margin="0,0,16,0"/>
            <CheckBox Content="He revisado las advertencias y deseo continuar" IsChecked="{Binding AdvertenciasReconocidas}"
                      Visibility="{Binding TieneAdvertencias, Converter={StaticResource BoolAVisibilidad}}"
                      VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="4. Generar libro de ventas (.xlsx)" Command="{Binding GenerarCommand}"
                    Style="{StaticResource BotonPrimarioStyle}" Margin="0,0,8,0"
                    ToolTip="Genera un solo .xlsx con una hoja por cada establecimiento registrado del cliente"/>
            <Button Content="Generar PDF" Command="{Binding GenerarPdfCommand}"
                    Style="{StaticResource BotonSecundarioStyle}" Margin="0,0,16,0"
                    ToolTip="Genera una versión PDF, lista para imprimir: un solo archivo con una sección por establecimiento, con folio y encabezados repetidos en cada hoja"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding ResumenLibros}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource AcentoBrush}" Margin="0,0,0,8"
                   Visibility="{Binding ResumenLibros, Converter={StaticResource NuloOVacioAVisibilidadConverter}}"/>

        <!-- Contenido: hallazgos + vista previa + aparte RANT/RECI/CIVA/NABN. Envuelto
             en un ScrollViewer para que la pantalla completa desplace en vez de
             achicar la tabla de facturas (que crece a su tamaño natural). -->
        <ScrollViewer x:Name="ScrollPrincipal" Grid.Row="7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MaxHeight="180"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Hallazgos}" Margin="0,0,0,8" Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                      Visibility="{Binding Hallazgos.Count, Converter={x:Static conv:ContadorAVisibilidadConverter.Instancia}}"
                      PreviewMouseWheel="ReenviarRuedaAlScrollPrincipal">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                                   Foreground="{Binding Severidad, Converter={StaticResource SeveridadAColorConverter}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Conteos: total / anuladas / descuadre de IVA -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="Facturas: " Foreground="{DynamicResource TextoSecundarioBrush}"/>
                    <Run Text="{Binding TotalFacturas, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <Border Style="{StaticResource PildoraConteoStyle}" Background="{DynamicResource BordeSuaveBrush}">
                    <TextBlock Text="{Binding ResumenAnuladas, StringFormat='{}{0} anuladas'}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border Style="{StaticResource PildoraConteoStyle}" Background="{DynamicResource FilaDescuadreIvaBrush}" Margin="0">
                    <TextBlock Text="{Binding ResumenDescuadre, StringFormat='{}{0} con descuadre de IVA'}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- No hay checkbox de incluir/excluir ni catálogo de revisión en ventas:
                 el único resaltado que aplica es amarillo (descuadre de IVA). -->
            <DataGrid x:Name="TablaVentas" Grid.Row="2" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserSortColumns="True" MaxHeight="560"
                      SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                      ColumnHeaderStyle="{StaticResource EncabezadoTablaStyle}" CellStyle="{StaticResource CeldaTablaStyle}"
                      Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                      BorderThickness="1" PreviewMouseWheel="ReenviarRuedaAlScrollPrincipal">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource TarjetaFondoBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DescuadreIva}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FilaDescuadreIvaBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Establecimiento" Binding="{Binding OrigenFel.CodigoEstablecimiento}" Width="0.9*" SortMemberPath="OrigenFel.CodigoEstablecimiento"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="0.8*" SortMemberPath="Fecha"/>
                    <DataGridTextColumn Header="Docto" Binding="{Binding Docto}" Width="0.6*" SortMemberPath="Docto"/>
                    <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="0.9*" SortMemberPath="Serie"/>
                    <DataGridTextColumn Header="Número" Binding="{Binding NoDoc}" Width="0.9*" SortMemberPath="NoDoc"/>
                    <DataGridTextColumn Header="Nit" Binding="{Binding Nit}" Width="0.8*" SortMemberPath="Nit"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" SortMemberPath="Nombre"/>
                    <DataGridTextColumn Header="Marca de Anulado" Binding="{Binding Anulada, Converter={x:Static conv:BoolASiNoConverter.Instancia}}" Width="0.9*" SortMemberPath="Anulada"/>
                    <DataGridTextColumn Header="Ventas" Binding="{Binding Ventas, StringFormat=N2}" Width="0.9*"/>
                    <DataGridTextColumn Header="Servicios" Binding="{Binding Servicios, StringFormat=N2}" Width="0.9*"/>
                    <DataGridTextColumn Header="Exportaciones" Binding="{Binding Exportaciones, StringFormat=N2}" Width="1*"/>
                    <DataGridTextColumn Header="INGUAT" Binding="{Binding Inguat, StringFormat=N2}" Width="0.9*"/>

                    <!-- Columna informativa: NO se exporta al Excel de salida -->
                    <DataGridTextColumn Header="Cálculo de IVA" Binding="{Binding CalculoIva, StringFormat=N2}" Width="1*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource EncabezadoTablaStyle}">
                                <Setter Property="Background" Value="{DynamicResource ColumnaInformativaFondoBrush}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource CeldaTablaStyle}">
                                <Setter Property="Background" Value="{DynamicResource ColumnaInformativaFondoBrush}"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Iva" Binding="{Binding Iva, StringFormat=N2}" Width="0.9*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="0.9*"/>

                    <DataGridTemplateColumn Header="Detalle" Width="0.7*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Ver" Style="{StaticResource BotonAccionTablaStyle}"
                                        Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Resumen/totales en vivo, sobre TODAS las filas (no hay incluir/excluir en ventas). -->
            <UniformGrid Grid.Row="3" Rows="1" Columns="4" Margin="0,12,0,0">
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="Ventas" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenVentas, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="Servicios" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenServicios, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}">
                    <StackPanel>
                        <TextBlock Text="IVA" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenIva, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaResumenStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Gran Total" Style="{StaticResource EtiquetaCampoStyle}"/>
                        <TextBlock Text="{Binding ResumenTotal, StringFormat='Q {0:N2}'}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AcentoBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Documentos tipo RANT/RECI/CIVA/NABN: van aparte del libro (no afectan totales) -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0"
                        Visibility="{Binding FilasAparte.Count, Converter={x:Static conv:ContadorAVisibilidadConverter.Instancia}}">
                <TextBlock Text="Documentos tipo RANT / RECI / CIVA / NABN — no afectan el libro de ventas" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding FilasAparte}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="True" MaxHeight="160"
                          SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                          ColumnHeaderStyle="{StaticResource EncabezadoTablaStyle}" CellStyle="{StaticResource CeldaTablaStyle}"
                          RowStyle="{StaticResource FilaTablaStyle}"
                          Background="{DynamicResource TarjetaFondoBrush}" BorderBrush="{DynamicResource BordeSuaveBrush}"
                          BorderThickness="1" PreviewMouseWheel="ReenviarRuedaAlScrollPrincipal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Establecimiento" Binding="{Binding OrigenFel.CodigoEstablecimiento}" Width="0.9*" SortMemberPath="OrigenFel.CodigoEstablecimiento"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="0.8*" SortMemberPath="Fecha"/>
                        <DataGridTextColumn Header="Docto" Binding="{Binding Docto}" Width="0.6*" SortMemberPath="Docto"/>
                        <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="1*" SortMemberPath="Serie"/>
                        <DataGridTextColumn Header="Número" Binding="{Binding NoDoc}" Width="1*" SortMemberPath="NoDoc"/>
                        <DataGridTextColumn Header="Nit" Binding="{Binding Nit}" Width="0.8*" SortMemberPath="Nit"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2.2*" SortMemberPath="Nombre"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="0.9*"/>
                        <DataGridTemplateColumn Header="Detalle" Width="0.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ver" Style="{StaticResource BotonAccionTablaStyle}"
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="8" Text="{Binding MensajeEstado}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </Grid>
</UserControl>
